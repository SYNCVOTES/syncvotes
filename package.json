{
	"name": "syncvotes",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"scripts": {
		"deploy:testnet": "[ -z \"$(git status --porcelain)\" ] && GIT_SHA=$(git rev-parse --short=12 HEAD) docker --context syncvotes-testnet compose --env-file testnet.env build && docker --context syncvotes-testnet compose --env-file testnet.env up -d",
		"deploy:mainnet": "[ -z \"$(git status --porcelain)\" ] && GIT_SHA=$(git rev-parse --short=12 HEAD) docker --context syncvotes-mainnet compose --env-file mainnet.env build && docker --context syncvotes-mainnet compose --env-file mainnet.env up -d",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"daml:codegen": "cd daml && rm -rf .daml/dist && dpm build && cd .. && rm -rf daml.js && dpm codegen-js daml/.daml/dist/*.dar -o daml.js",
		"@daml.js/model": "workspace:@daml.js/syncvotes-options-0.21.0@*",
		"@daml/types": "3.5.2",
		"dompurify": "^3.4.15",
		"marked": "^18.0.13"
	},
	"devDependencies": {
		"@canton-network/core-ledger-proto": "1.10.0",
		"@canton-network/core-tx-visualizer": "^1.11.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.46.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@protobuf-ts/runtime": "^2.11.1",
		"@scure/bip39": "^2.4.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"valibot": "^1.4.2",
		"vite": "^8.0.16"
	}
}
