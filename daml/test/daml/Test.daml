-- The model's claims, checked in Daml Script: what the ledger refuses no matter who asks.
-- Run with `dpm test` in the DAR build; a failing claim fails the build.
module Test where

import DA.Time (days, addRelTime)
import DA.List (head)
import DA.Optional (fromSome)
import Daml.Script
import Main

data Setup = Setup with
  provider : Party
  operator : Party
  alice : Party
  bob : Party
  mallory : Party
  dao : ContractId DAO
  aliceM : ContractId Member
  bobM : ContractId Member

routineRule : Rule
routineRule = Rule OfAll Majority 0 True False

sensitiveRule : Rule
sensitiveRule = Rule OfAll (Fraction 2 3) 0 True False

-- | A DAO of alice (its creator) and bob, by membership.
setup : Script Setup
setup = do
  provider <- allocateParty "provider"
  operator <- allocateParty "operator"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  mallory <- allocateParty "mallory"
  account <- submit provider do createCmd Account with provider; operator; user = alice
  dao <- submit alice do
    exerciseCmd account Account_CreateDAO with
      id = "dao-1"; daoName = "Club"; description = ""; image = None; equal = True
      routine = Settings routineRule 7; sensitive = Settings sensitiveRule 14
      shares = [(alice, 1), (bob, 1)]; more = []
  members <- query @Member alice
  let memberOf p = fst (fromSome (find (\(_, m) -> m.party == p) members))
  pure Setup with
    provider; operator; alice; bob; mallory; dao
    aliceM = memberOf alice; bobM = memberOf bob

-- | A member proposes, reading the DAO alongside the operator, as the app does.
propose : Setup -> ContractId Member -> Party -> Text -> Effect -> Script (ContractId Proposal)
propose s member party pid action =
  submit (actAs party <> readAs s.operator) do
    exerciseCmd member Member_Propose with dao = s.dao; pid; title = pid; description = ""; action

-- | A member's contract as it stands now (voting replaces it).
memberNow : Setup -> Party -> Script (ContractId Member)
memberNow s party = do
  members <- query @Member s.alice
  pure (fst (fromSome (find (\(_, m) -> m.party == party) members)))

-- | A ballot the count refuses is a wasted ballot, not a vote: a voter who names another
-- deadline than the proposal's is not counted, and cannot make the count wait for anyone.
decoyBallot : Script ()
decoyBallot = do
  s <- setup
  p <- propose s s.aliceM s.alice "p1" Signal
  Some proposal <- queryContractId s.provider p
  decoy <- submit s.bob do
    exerciseCmd s.bobM Member_Vote with
      proposalId = "p1"; closesAt = addRelTime proposal.closesAt (days 1); changeable = False
      vote = Yes; previous = None
  submitMustFail s.provider do
    exerciseCmd p Proposal_Tally with ballots = [decoy]; final = False
  real <- submit s.alice do
    exerciseCmd s.aliceM Member_Vote with
      proposalId = "p1"; closesAt = proposal.closesAt; changeable = False; vote = Yes; previous = None
  p2 <- submit s.provider do
    exerciseCmd p Proposal_Tally with ballots = [real]; final = False
  Some counted <- queryContractId s.provider p2
  assertMsg "One unit of yes was counted" (counted.yes == 1 && counted.no == 0)
  -- Alice cannot vote twice where votes cannot change.
  aliceM <- memberNow s s.alice
  submitMustFail s.alice do
    exerciseCmd aliceM Member_Vote with
      proposalId = "p1"; closesAt = proposal.closesAt; changeable = False; vote = No; previous = None
  -- A ballot cast after the deadline is refused at the count.
  passTime (days 8)
  bobM <- memberNow s s.bob
  late <- submit s.bob do
    exerciseCmd bobM Member_Vote with
      proposalId = "p1"; closesAt = proposal.closesAt; changeable = False; vote = No; previous = None
  submitMustFail s.provider do
    exerciseCmd p2 Proposal_Tally with ballots = [late]; final = True
  pure ()

-- | Nobody invents a member alone, and a share change names each party once.
duplicateMember : Script ()
duplicateMember = do
  s <- setup
  now <- getTime
  submitMustFail s.provider do
    createCmd Member with
      provider = s.provider; operator = s.operator; creator = s.alice; daoId = "dao-1"
      party = s.mallory; since = now; share = 1; shareSince = now; voted = []
  submitMustFail s.alice do
    createCmd Member with
      provider = s.provider; operator = s.operator; creator = s.alice; daoId = "dao-1"
      party = s.mallory; since = now; share = 1; shareSince = now; voted = []
  submitMustFail (actAs s.alice <> readAs s.operator) do
    exerciseCmd s.aliceM Member_Propose with
      dao = s.dao; pid = "twice"; title = "twice"; description = ""
      action = SetShares [(s.bob, 0), (s.bob, 1)]
  -- By membership, a member holds one unit or none.
  submitMustFail (actAs s.alice <> readAs s.operator) do
    exerciseCmd s.aliceM Member_Propose with
      dao = s.dao; pid = "two"; title = "two"; description = ""
      action = SetShares [(s.mallory, 2)]
  pure ()

-- | A dissolution passed under the sensitive rule archives the DAO at once; nothing is
-- proposed on it after.
dissolution : Script ()
dissolution = do
  s <- setup
  p <- propose s s.aliceM s.alice "wind-up" Dissolve
  Some proposal <- queryContractId s.provider p
  assertMsg "Dissolution runs under the sensitive rule" (proposal.rule == sensitiveRule)
  a <- submit s.alice do
    exerciseCmd s.aliceM Member_Vote with
      proposalId = "wind-up"; closesAt = proposal.closesAt; changeable = False; vote = Yes; previous = None
  b <- submit s.bob do
    exerciseCmd s.bobM Member_Vote with
      proposalId = "wind-up"; closesAt = proposal.closesAt; changeable = False; vote = Yes; previous = None
  p2 <- submit s.provider do
    exerciseCmd p Proposal_Tally with ballots = [a, b]; final = False
  Some settled <- queryContractId s.provider p2
  assertMsg "Two of two say yes: passed early" (settled.outcome == Some Passed)
  -- Nobody but the provider carries it out, and only through the DAO.
  submitMustFail s.alice do
    exerciseCmd p2 Proposal_Advance with upTo = 1
  gone <- submit s.provider do
    exerciseCmd s.dao DAO_Execute with proposal = p2; current = []; upTo = 1
  assertMsg "The DAO is archived" (gone == None)
  daoNow <- queryContractId s.provider s.dao
  assertMsg "The DAO is gone" (daoNow == None)
  aliceM <- memberNow s s.alice
  submitMustFail (actAs s.alice <> readAs s.operator) do
    exerciseCmd aliceM Member_Propose with
      dao = s.dao; pid = "after"; title = "after"; description = ""; action = Signal
  pure ()

-- | Settings the ledger refuses: early settlement with changeable votes, a quorum past a
-- hundred, a vote open for no days. And a comment only its author touches.
rules : Script ()
rules = do
  s <- setup
  account <- fst . head <$> query @Account s.alice
  let founding routine sensitive = submitMustFail s.alice do
        exerciseCmd account Account_CreateDAO with
          id = "dao-2"; daoName = "Bad"; description = ""; image = None; equal = True
          routine; sensitive; shares = [(s.alice, 1)]; more = []
  founding (Settings (Rule OfAll Majority 0 True True) 7) (Settings sensitiveRule 14)
  founding (Settings (Rule OfAll Majority 101 False False) 7) (Settings sensitiveRule 14)
  founding (Settings routineRule 0) (Settings sensitiveRule 14)
  founding (Settings (Rule OfCast (Fraction 3 2) 0 False False) 7) (Settings sensitiveRule 14)
  -- A settings proposal is checked the same way.
  submitMustFail (actAs s.alice <> readAs s.operator) do
    exerciseCmd s.aliceM Member_Propose with
      dao = s.dao; pid = "bad"; title = "bad"; description = ""
      action = SetSettings (Settings (Rule OfAll Majority 0 True True) 7) (Settings sensitiveRule 14)
  -- A comment: its author edits and deletes it; nobody else does, the provider included.
  p <- propose s s.aliceM s.alice "talk" Signal
  c <- submit s.bob do
    exerciseCmd s.bobM Member_Comment with proposalId = "talk"; cid = "c1"; body = "hello"
  submitMustFail s.alice do exerciseCmd c Comment_Edit with newBody = "hijacked"
  submitMustFail s.provider do exerciseCmd c Comment_Delete
  submit s.bob do exerciseCmd c Comment_Delete
  left <- queryContractId s.bob c
  assertMsg "The comment is gone" (left == None)
  pure ()
