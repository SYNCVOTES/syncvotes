module Main where

import DA.List (dedup)
import DA.Optional (fromOptional, isNone)

-- The whole model rests on one idea: every contract a user acts on already carries the app
-- provider's signature, so the provider is a confirmer of every transaction — which is what
-- CIP-0104 pays traffic rewards for — while the user's own key is the only one that ever signs
-- a submission. The provider's authority enters once, when the account is created, and every
-- later contract inherits it through the choice that creates it.
--
-- Two provider-side parties, per the Featured App Coupon Guidance on separating concerns: the
-- provider holds the FeaturedAppRight and only ever signs; the operator is the backend's own
-- party, an observer that reads and never earns.

data Vote = Yes | No
  deriving (Eq, Show)

data Ballot = Ballot with
    voter : Party
    vote : Vote
  deriving (Eq, Show)

data Outcome = Passed | Failed
  deriving (Eq, Show)

-- | A user's standing with the app: their name in the directory, and the door through which
-- they create DAOs. Created by the provider once per party.
template Account
  with
    provider : Party
    operator : Party
    user : Party
    name : Text
  where
    signatory provider
    observer user, operator

    ensure name /= ""

    nonconsuming choice Account_CreateDAO : ContractId DAO
      with
        daoName : Text
        description : Text
        members : [Party]
      controller user
      do create DAO with
           provider; operator; admin = user; name = daoName; description
           members = dedup (user :: members)

-- | A DAO is private to its members: only they, the provider and the operator ever see it.
-- Membership is fixed at creation in this version.
template DAO
  with
    provider : Party
    operator : Party
    admin : Party
    name : Text
    description : Text
    members : [Party]
  where
    signatory admin, provider
    observer members, operator

    ensure name /= "" && admin `elem` members

    nonconsuming choice DAO_CreateProposal : ContractId Proposal
      with
        proposer : Party
        title : Text
        description : Text
        closesAt : Time
        -- A stable handle: every vote replaces the contract, so the contract id cannot be the
        -- proposal's identity. Optional and last, for the upgrade from 0.1.0.
        id : Optional Text
      controller proposer
      do
        assertMsg "Only members can propose" (proposer `elem` members)
        now <- getTime
        assertMsg "The voting deadline must be in the future" (closesAt > now)
        create Proposal with
          provider; operator; dao = self; daoName = name; proposer; title; description
          members; closesAt; ballots = []; outcome = None; id

-- | The simplest vote that works: each member says Yes or No once; the proposal passes when a
-- majority of all members said Yes. The vote that settles the outcome records it; a proposal
-- that reaches its deadline unsettled can be closed by any member.
template Proposal
  with
    provider : Party
    operator : Party
    dao : ContractId DAO
    daoName : Text
    proposer : Party
    title : Text
    description : Text
    members : [Party]
    closesAt : Time
    ballots : [Ballot]
    outcome : Optional Outcome
    id : Optional Text
  where
    signatory proposer, provider
    observer members, operator

    ensure title /= ""

    choice Proposal_Vote : ContractId Proposal
      with
        voter : Party
        vote : Vote
      controller voter
      do
        assertMsg "Only members can vote" (voter `elem` members)
        assertMsg "Voting is over" (isNone outcome)
        now <- getTime
        assertMsg "The deadline has passed" (now < closesAt)
        assertMsg "Already voted" (not (any (\b -> b.voter == voter) ballots))
        let cast = Ballot voter vote :: ballots
        create this with ballots = cast; outcome = decide members cast

    choice Proposal_Close : ContractId Proposal
      with
        closer : Party
      controller closer
      do
        assertMsg "Only members can close" (closer `elem` members)
        assertMsg "Already closed" (isNone outcome)
        now <- getTime
        assertMsg "Still open" (now >= closesAt)
        create this with outcome = Some (fromOptional Failed (decide members ballots))

-- | Settled when Yes has a majority of all members, or when No has made one impossible.
decide : [Party] -> [Ballot] -> Optional Outcome
decide members ballots =
  let yes = length (filter (\b -> b.vote == Yes) ballots)
      no = length (filter (\b -> b.vote == No) ballots)
      needed = length members / 2 + 1
  in if yes >= needed then Some Passed
     else if length members - no < needed then Some Failed
     else None
