module Main where

import DA.Action (foldlA)
import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (isNone, isSome, optional)

-- Every contract a user acts on carries the app provider's signature, so the provider confirms
-- every transaction (which is what earns traffic rewards) while the user's own key is the only
-- one that ever signs a submission. The provider's authority enters once, with the Account, and
-- every later contract inherits it through the choice that creates it.
--
-- Built for large DAOs: a member's vote touches only that member's own contract, so thousands
-- can vote at once, and a proposal holds counters rather than lists. The provider counts the
-- ballots in batches; the ledger checks each one it is handed, so the provider can delay a
-- result but never change it.

data Vote = Yes | No | Abstain
  deriving (Eq, Show)

data Outcome = Passed | Failed
  deriving (Eq, Show)

-- | A party's standing with the app: created by the provider once per party, and the door
-- through which the party creates DAOs.
template Account
  with
    provider : Party
    operator : Party
    user : Party
  where
    signatory provider
    observer user, operator

    nonconsuming choice Account_CreateDAO : ContractId DAO
      with
        id : Text
        daoName : Text
        description : Text
      controller user
      do
        now <- getTime
        create Member with
          provider; operator; admin = user; daoId = id; party = user; since = now; voted = []
        create DAO with
          provider; operator; admin = user; id; name = daoName; description; createdAt = now
          members = 1

-- | A DAO: who runs it, what it is called, and how many members it has. The members themselves
-- are `Member` contracts, so a DAO of ten thousand is as small as a DAO of three.
template DAO
  with
    provider : Party
    operator : Party
    admin : Party
    id : Text
    name : Text
    description : Text
    createdAt : Time
    members : Int
  where
    signatory admin, provider
    observer operator

    ensure name /= ""

    choice DAO_Update : ContractId DAO
      with
        daoName : Text
        description : Text
      controller admin
      do create this with name = daoName; description

    choice DAO_Archive : ()
      controller admin
      do pure ()

    choice DAO_AddMembers : ContractId DAO
      with
        parties : [Party]
      controller admin
      do
        now <- getTime
        let new = dedup parties
        forA_ new \party ->
          create Member with provider; operator; admin; daoId = id; party; since = now; voted = []
        create this with members = members + length new

    choice DAO_RemoveMembers : ContractId DAO
      with
        memberCids : [ContractId Member]
      controller admin
      do
        forA_ memberCids \cid -> do
          member <- fetch cid
          assertMsg "Not a member of this DAO" (member.daoId == id)
          assertMsg "The admin stays a member" (member.party /= admin)
          archive cid
        create this with members = members - length memberCids

-- | One party's membership of one DAO: the door through which the member proposes, and their
-- ballot box — voting replaces it with a copy that remembers the proposal, which is what makes
-- a second ballot impossible. A member sees this contract and nothing of the DAO's own, so
-- everything a member does starts here.
template Member
  with
    provider : Party
    operator : Party
    admin : Party
    daoId : Text
    party : Party
    since : Time
    -- Proposals voted on whose deadline has not passed, with that deadline. Nothing can be cast
    -- on a proposal after its deadline, so entries past it are forgotten as the next vote is
    -- cast, and the contract stays the size of the member's open business, not their history.
    voted : [(Text, Time)]
  where
    signatory admin, provider
    observer party, operator

    -- The proposal is created here and opened by the provider the moment it sees it; what
    -- members vote on is what was proposed, never a later edit.
    nonconsuming choice Member_Propose : ContractId Proposal
      with
        pid : Text
        title : Text
        description : Text
        closesAt : Time
      controller party
      do
        now <- getTime
        assertMsg "The deadline must be in the future" (closesAt > now)
        create Proposal with
          provider; operator; daoId; admin; proposer = party; id = pid; title; description
          createdAt = now; closesAt; openedAt = None; eligible = 0; yes = 0; no = 0
          abstain = 0; outcome = None

    -- Nothing here reads the proposal, so a vote never waits on the count or on other voters.
    -- Whether the ballot is valid for its proposal (right DAO, member in time, before the
    -- deadline) is checked when the provider counts it.
    -- `closesAt` is the voter's word for the deadline; the count checks it against the
    -- proposal's. A voter who lies about it only wastes a ballot the count will refuse.
    choice Member_Vote : ContractId Ballot
      with
        proposalId : Text
        closesAt : Time
        vote : Vote
      controller party
      do
        now <- getTime
        let open = filter (\(_, deadline) -> deadline > now) voted
        assertMsg "Already voted" (proposalId `notElem` map fst open)
        create this with voted = (proposalId, closesAt) :: open
        create Ballot with
          provider; operator; daoId; proposalId; voter = party; since; vote; closesAt
          castAt = now; counted = False

-- | A proposal counts; it does not list. Opening it fixes the electorate: every member at that
-- moment, and only they. It passes once yes reaches a majority of them, fails once no makes
-- that impossible, and is decided by the ballots cast when the deadline has passed.
template Proposal
  with
    provider : Party
    operator : Party
    daoId : Text
    admin : Party
    proposer : Party
    id : Text
    title : Text
    description : Text
    createdAt : Time
    closesAt : Time
    openedAt : Optional Time
    eligible : Int
    yes : Int
    no : Int
    abstain : Int
    outcome : Optional Outcome
  where
    signatory proposer, provider
    observer operator, admin

    ensure title /= ""

    -- Opening fixes the electorate from the DAO's member count. The provider does it because
    -- the DAO contract is the admin's and the provider's to see — a member cannot read it — and
    -- the count comes off the ledger either way.
    choice Proposal_Open : ContractId Proposal
      with
        dao : ContractId DAO
      controller provider
      do
        assertMsg "Voting has opened" (isNone openedAt)
        found <- fetch dao
        assertMsg "Not this proposal's DAO" (found.id == daoId)
        now <- getTime
        create this with openedAt = Some now; eligible = found.members

    choice Proposal_Cancel : ()
      with
        canceller : Party
      controller canceller
      do
        assertMsg "Already settled" (isNone outcome)
        assertMsg "Only the proposer or the DAO admin can cancel"
          (canceller == proposer || canceller == admin)

    -- `final` says the deadline has passed and these are the last ballots there are: the one
    -- thing the ledger takes on the provider's word, since it cannot see what was not handed in.
    choice Proposal_Tally : ContractId Proposal
      with
        ballots : [ContractId Ballot]
        final : Bool
      controller provider
      do
        assertMsg "Voting has not opened" (isSome openedAt)
        assertMsg "Already settled" (isNone outcome)
        (y, n, a) <- foldlA
          (\(y, n, a) cid -> do
            vote <- exercise cid Ballot_Count with proposal = this
            pure case vote of
              Yes -> (y + 1, n, a)
              No -> (y, n + 1, a)
              Abstain -> (y, n, a + 1))
          (yes, no, abstain) ballots
        now <- getTime
        let needed = eligible / 2 + 1
            decided
              | y >= needed = Some Passed
              | eligible - n - a < needed = Some Failed
              | final && now >= closesAt = Some Failed
              | otherwise = None
        create this with yes = y; no = n; abstain = a; outcome = decided

-- | One vote. Signed by the voter and the provider; `since` is copied from the voter's
-- membership, so the count can tell whether they were a member when the vote opened. Counting
-- marks it rather than removing it, so who voted how stays on the ledger.
template Ballot
  with
    provider : Party
    operator : Party
    daoId : Text
    proposalId : Text
    voter : Party
    since : Time
    vote : Vote
    closesAt : Time
    castAt : Time
    counted : Bool
  where
    signatory voter, provider
    observer operator

    choice Ballot_Count : Vote
      with
        proposal : Proposal
      controller provider
      do
        assertMsg "Already counted" (not counted)
        assertMsg "A ballot for another proposal" (proposalId == proposal.id && daoId == proposal.daoId)
        assertMsg "Cast after the deadline" (castAt < proposal.closesAt)
        assertMsg "Cast against another deadline" (closesAt == proposal.closesAt)
        assertMsg "Joined after the vote opened" (optional False (since <=) proposal.openedAt)
        create this with counted = True
        pure vote
