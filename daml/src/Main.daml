module Main where

import DA.Action (foldlA, void, when)
import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (catOptionals, isNone)

-- Every contract a user acts on carries the app provider's signature, so the provider confirms
-- every transaction (which is what earns traffic rewards) while the user's own key is the only
-- one that ever signs a submission. The provider's authority enters once, with the Account, and
-- every later contract inherits it through the choice that creates it.
--
-- A DAO is signed by the party that created it as well, and that pair, creator and provider, is
-- the DAO's own authority: choices that only the DAO may exercise (removing a member, marking a
-- proposal executed) are controlled by both, and neither has the other's key. The creator has
-- no say of their own beyond that signature: everything a DAO does, it decides by vote.
--
-- Members hold shares of the vote — percentages that add up to a hundred — and a ballot weighs
-- the voter's share. Shares change only by vote, and a share moved while a proposal is open
-- does not vote on it twice: a ballot is refused if its share changed after the proposal was
-- made.
--
-- Built for large DAOs: a member's vote touches only that member's own contract, so thousands
-- can vote at once, and a proposal holds counters rather than lists. The provider counts the
-- ballots in batches; the ledger checks each one it is handed, so the provider can delay a
-- result but never change it. Nothing here grows with history.

data Vote = Yes | No | Abstain
  deriving (Eq, Show)

data Outcome = Passed | Failed
  deriving (Eq, Show)

-- | What a proposal does when it passes (`Effect`: `Action` is the Prelude's). `Signal`
-- decides and does nothing else; the rest is everything a DAO can change about itself.
data Effect
  = Signal
  | SetShares with
      shares : [(Party, Decimal)]
  | SetInfo with
      daoName : Text
      description : Text
  | Dissolve
  deriving (Eq, Show)

-- | What counts as passing, chosen per proposal. Yes is measured against all members, or
-- against the votes cast (yes and no; an abstention takes part but takes no side), and must be
-- a majority (strictly more than half) or at least a percentage. A quorum is the share of
-- members that must take part at all. `early` lets the proposal settle the moment its outcome
-- can no longer change; otherwise the deadline decides.
data Basis = OfAll | OfCast
  deriving (Eq, Show)

data Threshold = Majority | Percent Int
  deriving (Eq, Show)

data Rule = Rule with
    basis : Basis
    threshold : Threshold
    quorum : Int
    early : Bool
  deriving (Eq, Show)

validRule : Rule -> Bool
validRule r = r.quorum >= 0 && r.quorum <= 100 && case r.threshold of
  Majority -> True
  Percent p -> p >= 1 && p <= 100

-- | Members created or reshared per transaction; longer lists are split.
batch : Int
batch = 200

-- | The whole vote: shares add up to this.
total : Decimal
total = 100.0

-- | A share table is whole: every share positive, no party twice, the sum exactly the total.
validShares : [(Party, Decimal)] -> Bool
validShares shares =
  not (null shares)
    && length shares <= batch
    && all (\(_, s) -> s > 0.0) shares
    && dedup (map fst shares) == map fst shares
    && sum (map snd shares) == total

-- | A party's standing with the app: created by the provider once per party, and the door
-- through which the party creates DAOs.
template Account
  with
    provider : Party
    operator : Party
    user : Party
  where
    signatory provider
    observer user, operator

    nonconsuming choice Account_CreateDAO : ContractId DAO
      with
        id : Text
        daoName : Text
        description : Text
        shares : [(Party, Decimal)]
      controller user
      do
        now <- getTime
        assertMsg "Shares must be positive, unique and add up to 100" (validShares shares)
        forA_ shares \(party, share) ->
          create Member with
            provider; operator; creator = user; sponsor = user; daoId = id; party; since = now
            share; shareSince = now; voted = []
        create DAO with
          provider; operator; creator = user; id; name = daoName; description; createdAt = now
          members = length shares

-- | A DAO: who created it, what it is called, and how many members it has. The members
-- themselves are `Member` contracts, so a DAO of ten thousand is as small as one of three.
-- Nobody changes it by hand: its one choice carries out what a vote decided. The creator's
-- signature is what keeps the provider from archiving it alone.
template DAO
  with
    provider : Party
    operator : Party
    creator : Party
    id : Text
    name : Text
    description : Text
    createdAt : Time
    members : Int
  where
    signatory creator, provider
    observer operator

    ensure name /= ""

    -- A passed proposal is carried out by the provider, with the DAO's authority and the
    -- ledger's check that it did pass. A new share table needs every current member's
    -- contract handed in (a proposal names parties; the ledger checks the count and each one):
    -- those in the table are reshared, those not in it leave, those new to it join. Dissolving
    -- archives the DAO and returns nothing.
    choice DAO_Execute : Optional (ContractId DAO)
      with
        proposal : ContractId Proposal
        current : [ContractId Member]
      controller provider
      do
        p <- fetch proposal
        assertMsg "Not this DAO's proposal" (p.daoId == id)
        exercise proposal Proposal_MarkExecuted
        now <- getTime
        case p.action of
          Signal -> Some <$> create this
          SetInfo daoName description -> Some <$> create this with name = daoName; description
          Dissolve -> pure None
          SetShares shares -> do
            assertMsg "Every current member must be handed in" (length current == members)
            assertMsg "A member handed in twice" (dedup current == current)
            kept <- forA current \cid -> do
              member <- fetch cid
              assertMsg "Not a member of this DAO" (member.daoId == id)
              case lookup member.party shares of
                None -> do
                  exercise cid Member_Remove
                  pure None
                Some share -> do
                  when (share /= member.share) (void (exercise cid Member_Reshare with share))
                  pure (Some member.party)
            let staying = catOptionals kept
                joining = filter (\(party, _) -> party `notElem` staying) shares
            forA_ joining \(party, share) ->
              create Member with
                provider; operator; creator; sponsor = creator; daoId = id; party; since = now
                share; shareSince = now; voted = []
            Some <$> create this with members = length shares

-- | One party's membership of one DAO, with its share of the vote: the door through which the
-- member proposes, and their ballot box — voting replaces it with a copy that remembers the proposal, which is what makes
-- a second ballot impossible. Signed by whoever admitted the member, so the provider cannot
-- invent members; removed only with the DAO's authority.
template Member
  with
    provider : Party
    operator : Party
    creator : Party
    sponsor : Party
    daoId : Text
    party : Party
    since : Time
    share : Decimal
    shareSince : Time
    -- Proposals voted on whose deadline has not passed, with that deadline. Nothing can be cast
    -- on a proposal after its deadline, so entries past it are forgotten as the next vote is
    -- cast, and the contract stays the size of the member's open business, not their history.
    voted : [(Text, Time)]
  where
    signatory provider, sponsor
    observer party, operator

    choice Member_Remove : ()
      controller provider, creator
      do pure ()

    choice Member_Reshare : ContractId Member
      with
        share : Decimal
      controller provider, creator
      do
        now <- getTime
        create this with share; shareSince = now

    -- The DAO is read as it is now (the app's operator reads alongside the member): its member
    -- count is fixed into the proposal as the electorate, and voting is open from this moment.
    -- What members vote on is what was proposed.
    nonconsuming choice Member_Propose : ContractId Proposal
      with
        dao : ContractId DAO
        pid : Text
        title : Text
        description : Text
        closesAt : Time
        action : Effect
        rule : Rule
      controller party
      do
        now <- getTime
        found <- fetch dao
        assertMsg "Not this member's DAO" (found.id == daoId)
        assertMsg "The deadline must be in the future" (closesAt > now)
        assertMsg "The rule's numbers are out of range" (validRule rule)
        case action of
          Signal -> pure ()
          Dissolve -> pure ()
          SetInfo daoName _ -> assertMsg "A DAO needs a name" (daoName /= "")
          SetShares shares ->
            assertMsg "Shares must be positive, unique and add up to 100" (validShares shares)
        create Proposal with
          provider; operator; creator; daoId; proposer = party; id = pid; title; description
          action; rule; createdAt = now; closesAt; yes = 0.0; no = 0.0; abstain = 0.0
          outcome = None; executedAt = None

    -- Nothing here reads the proposal, so a vote never waits on the count or on other voters.
    -- Whether the ballot is valid for its proposal (right DAO, member in time, before the
    -- deadline) is checked when the provider counts it. `closesAt` is the voter's word for the
    -- deadline; a voter who lies about it only wastes a ballot the count will refuse.
    choice Member_Vote : ContractId Ballot
      with
        proposalId : Text
        closesAt : Time
        vote : Vote
      controller party
      do
        now <- getTime
        let open = filter (\(_, deadline) -> deadline > now) voted
        assertMsg "Already voted" (proposalId `notElem` map fst open)
        create this with voted = (proposalId, closesAt) :: open
        create Ballot with
          provider; operator; daoId; proposalId; voter = party; since; vote; weight = share
          shareSince; closesAt; castAt = now; counted = False

-- | A proposal counts; it does not list. Its electorate was fixed when it was made: the shares
-- of that moment, a hundred in all; its rule says what passing takes. With `early` it settles the moment the
-- outcome can no longer change; either way the deadline decides by what was cast. Nobody
-- withdraws it: once made, it is decided. An action is carried out by the DAO once it has
-- passed.
template Proposal
  with
    provider : Party
    operator : Party
    creator : Party
    daoId : Text
    proposer : Party
    id : Text
    title : Text
    description : Text
    action : Effect
    rule : Rule
    createdAt : Time
    closesAt : Time
    yes : Decimal
    no : Decimal
    abstain : Decimal
    outcome : Optional Outcome
    executedAt : Optional Time
  where
    signatory proposer, provider
    observer operator

    ensure title /= ""

    -- `final` says the deadline has passed and these are the last ballots there are: the one
    -- thing the ledger takes on the provider's word, since it cannot see what was not handed in.
    choice Proposal_Tally : ContractId Proposal
      with
        ballots : [ContractId Ballot]
        final : Bool
      controller provider
      do
        assertMsg "Already settled" (isNone outcome)
        (y, n, a) <- foldlA
          (\(y, n, a) cid -> do
            (vote, weight) <- exercise cid Ballot_Count with proposal = this
            pure case vote of
              Yes -> (y + weight, n, a)
              No -> (y, n + weight, a)
              Abstain -> (y, n, a + weight))
          (yes, no, abstain) ballots
        now <- getTime
        let cast = y + n + a
            outstanding = total - cast
            quorumMet = rule.quorum == 0 || cast >= intToDecimal rule.quorum
            meets yes denom = denom > 0.0 && case rule.threshold of
              Majority -> yes * 2.0 > denom
              Percent p -> yes * 100.0 >= denom * intToDecimal p
            -- What yes is measured against now, and in the worst case still to come.
            denomNow = case rule.basis of
              OfAll -> total
              OfCast -> y + n
            denomWorst = case rule.basis of
              OfAll -> total
              OfCast -> y + n + outstanding
            passedNow = quorumMet && meets y denomNow
            -- Sure: yes wins whatever the rest do. Lost: yes cannot win even if the rest all say yes.
            sure = quorumMet && meets y denomWorst
            lost = not (meets (y + outstanding) denomWorst)
            over = final && now >= closesAt
            decided
              | rule.early && sure = Some Passed
              | rule.early && lost = Some Failed
              | over = Some (if passedNow then Passed else Failed)
              | otherwise = None
        create this with yes = y; no = n; abstain = a; outcome = decided

    -- Only the DAO (creator and provider together) marks a proposal executed, and only once.
    choice Proposal_MarkExecuted : ContractId Proposal
      controller provider, creator
      do
        assertMsg "The proposal did not pass" (outcome == Some Passed)
        assertMsg "Already executed" (isNone executedAt)
        now <- getTime
        create this with executedAt = Some now

-- | One vote, weighing the voter's share. Signed by the voter and the provider; `since` and
-- `shareSince` are copied from the voter's membership, so the count can tell whether they were a
-- member, with that share, when the vote opened. Counting marks it rather than removing it, so
-- who voted how stays on the ledger.
template Ballot
  with
    provider : Party
    operator : Party
    daoId : Text
    proposalId : Text
    voter : Party
    since : Time
    vote : Vote
    weight : Decimal
    shareSince : Time
    closesAt : Time
    castAt : Time
    counted : Bool
  where
    signatory voter, provider
    observer operator

    choice Ballot_Count : (Vote, Decimal)
      with
        proposal : Proposal
      controller provider
      do
        assertMsg "Already counted" (not counted)
        assertMsg "A ballot for another proposal" (proposalId == proposal.id && daoId == proposal.daoId)
        assertMsg "Cast after the deadline" (castAt < proposal.closesAt)
        assertMsg "Cast against another deadline" (closesAt == proposal.closesAt)
        assertMsg "Joined after the vote opened" (since <= proposal.createdAt)
        assertMsg "The share changed after the vote opened" (shareSince <= proposal.createdAt)
        create this with counted = True
        pure (vote, weight)

-- | The provider's statement of a DAO's account: what was paid in, and what its
-- transactions have cost so far. Rewritten as the numbers move; one contract per DAO,
-- whatever its history.
template Meter
  with
    provider : Party
    operator : Party
    daoId : Text
    creator : Party
    credited : Decimal
    charged : Decimal
    updatedAt : Time
  where
    signatory provider
    observer operator, creator

    choice Meter_Update : ContractId Meter
      with
        newCredited : Decimal
        newCharged : Decimal
      controller provider
      do
        now <- getTime
        create this with credited = newCredited; charged = newCharged; updatedAt = now
