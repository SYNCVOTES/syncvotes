module Main where

import DA.Action (foldlA, void, when)
import DA.Foldable (forA_)
import DA.List (dedup, elemIndex, sortBy)
import DA.Optional (fromOptional, fromSome, isNone, isSome)
import qualified DA.Text as T
import DA.Time (addRelTime, days)

-- Every contract a user acts on carries the app provider's signature, so the provider confirms
-- every transaction (which is what earns traffic rewards) while the user's own key is the only
-- one that ever signs a submission. The provider's authority enters once, with the Account, and
-- every later contract inherits it through the choice that creates it.
--
-- A DAO is signed by the party that created it as well, and that pair, creator and provider, is
-- the DAO's own authority: every member, proposal, ballot and comment of the DAO carries both
-- signatures, so neither can invent one alone, and choices only the DAO may exercise (removing
-- a member, recording a proposal carried out) are controlled by both. The creator has no say of
-- their own beyond that signature: everything a DAO does, it decides by vote.
--
-- A DAO has settings of its own, set at the founding and changed only by vote: for routine
-- proposals and for sensitive ones, the rule they pass by and how long the vote is open. A
-- proposer chooses what to propose, never what it takes.
--
-- Members hold shares of the vote, counted in whole units — one each in a DAO that votes by
-- membership, any number in one that votes by shares — and a ballot weighs the voter's units.
-- Shares change only by vote, and a share moved while a proposal is open does not vote on it
-- twice: a ballot is refused if its share changed after the proposal was made.
--
-- A DAO holds no coin. Its transactions cost the provider traffic, and the DAO's balance with
-- the provider — coin anyone sends to the provider with the DAO's memo, less what its
-- transactions cost — is the provider's statement (`Meter`), not money on the ledger.
--
-- Built for large DAOs: a member's vote touches only that member's own contract, so thousands
-- can vote at once, and a proposal holds counters rather than lists. The provider counts the
-- ballots in batches; the ledger checks each one it is handed, so the provider can delay a
-- result but never change it. Nothing here grows with history.

-- | Yes, no or abstain on a proposal; or, on a choice among options, the option picked —
-- or several of them, where the proposal allows it.
data Vote = Yes | No | Abstain | Pick Int | PickMany [Int]
  deriving (Eq, Show)

-- | Passed or failed; a choice among options is decided as the option chosen, or fails when
-- none reached the rule (a tie at the deadline fails too). A choice that takes several picks
-- is decided as every option that reached the rule.
data Outcome = Passed | Failed | Chosen Int | ChosenMany [Int]
  deriving (Eq, Show)

-- | What a proposal does when it passes (`Effect`: `Action` is the Prelude's). `Signal`
-- decides yes or no and does nothing else; `Choose` decides among options the same way,
-- the winning option measured against the rule as yes would be; the rest is everything a DAO
-- can change about itself. A share change lists only the parties it touches, zero meaning
-- they leave; carried out in batches, so one proposal can reshape a DAO of thousands.
data Effect
  = Signal
  | Choose with
      options : [Text]
      -- Each member picks several options rather than one; every option that reaches the rule
      -- is chosen. Absent on proposals made before there was such a thing.
      several : Optional Bool
  | SetShares with
      changes : [(Party, Int)]
  | SetInfo with
      daoName : Text
      description : Text
      image : Optional Text
  | Dissolve
  | SetSettings with
      routine : Settings
      sensitive : Settings
  | SetPublic with
      public : Bool
  deriving (Eq, Show)

-- | What a proposal does decides which of the DAO's two settings it runs under: the routine
-- ones for a decision or a new name, the sensitive ones for anything touching members, the
-- rules or the DAO's existence.
isSensitive : Effect -> Bool
isSensitive Signal = False
isSensitive (Choose _ _) = False
isSensitive _ = True

-- | What counts as passing, chosen per proposal. Yes is measured against all members, or
-- against the votes cast (yes and no; an abstention takes part but takes no side), and must be
-- a majority (strictly more than half), at least a percentage, or at least a fraction (two
-- thirds of three is two, not the three that 67% would demand). A quorum is the share of
-- members that must take part at all. `early` lets the proposal settle the moment its outcome
-- can no longer change; `changeable` lets a voter replace their ballot until the deadline. The
-- two exclude each other: an outcome that is sure only while nobody changes their mind is not
-- sure.
data Basis = OfAll | OfCast
  deriving (Eq, Show)

data Threshold
  = Majority
  | Percent Int
  | Fraction with
      num : Int
      den : Int
  deriving (Eq, Show)

data Rule = Rule with
    basis : Basis
    threshold : Threshold
    quorum : Int
    early : Bool
    changeable : Bool
  deriving (Eq, Show)

validRule : Rule -> Bool
validRule r =
  r.quorum >= 0 && r.quorum <= 100
    && not (r.early && r.changeable)
    && case r.threshold of
      Majority -> True
      Percent p -> p >= 1 && p <= 100
      Fraction num den -> num >= 1 && num <= den && den <= 100

-- | What proposals of a category run under: the rule they pass by, and how many days the
-- vote is open. Set at the founding, changed only by vote.
data Settings = Settings with
    rule : Rule
    votingDays : Int
  deriving (Eq, Show)

validSettings : Settings -> Bool
validSettings s = validRule s.rule && s.votingDays >= 1 && s.votingDays <= 90

-- | A choice offers two to ten distinct options, a few words each.
validOptions : [Text] -> Bool
validOptions options =
  length options >= 2 && length options <= 10
    && all (\o -> o /= "" && T.length o <= 80) options
    && dedup options == options

-- | Members created, reshared or removed per transaction; longer lists are carried out in
-- several.
batch : Int
batch = 200

-- | The most parties one share change may touch.
maxChanges : Int
maxChanges = 2000

-- | A share change names each party once, with a whole number of units, zero to leave. In a
-- DAO that votes by membership a member holds one unit or none.
validChanges : Bool -> [(Party, Int)] -> Bool
validChanges equal changes =
  not (null changes)
    && length changes <= maxChanges
    && all (\(_, units) -> units >= 0 && (not equal || units <= 1)) changes
    && dedup (map fst changes) == map fst changes

-- | A party's standing with the app: created by the provider once per party, and the door
-- through which the party creates DAOs and keeps a profile.
template Account
  with
    provider : Party
    operator : Party
    user : Party
  where
    signatory provider
    observer user, operator

    -- The founding share table: the first batch of members is created here, the rest as a
    -- proposal already passed, carried out by the provider in batches like any other. The
    -- creator holds a share.
    nonconsuming choice Account_CreateDAO : ContractId DAO
      with
        id : Text
        daoName : Text
        description : Text
        image : Optional Text
        equal : Bool
        routine : Settings
        sensitive : Settings
        shares : [(Party, Int)]
        more : [(Party, Int)]
        -- Who pays the traffic of the DAO's transactions: its own balance (the default), or
        -- each member for what they sign, from their own balance. Set at the founding.
        actorPays : Optional Bool
        -- Readable by anyone signed in to the app, not only its members; changed by vote.
        public : Optional Bool
      controller user
      do
        now <- getTime
        assertMsg "A DAO needs a name" (daoName /= "")
        assertMsg "The settings' numbers are out of range" (validSettings routine && validSettings sensitive)
        assertMsg "The founding shares must be whole" (validChanges equal (shares ++ more))
        assertMsg "The first batch is one to a batch" (not (null shares) && length shares <= batch)
        assertMsg "The founding shares are all positive" (all (\(_, u) -> u > 0) (shares ++ more))
        assertMsg "The creator holds a share" (user `elem` map fst (shares ++ more))
        forA_ shares \(party, units) ->
          create Member with
            provider; operator; creator = user; daoId = id; party; since = now
            share = units; shareSince = now; voted = []
        when (not (null more)) do
          void $ create Proposal with
            provider; operator; creator = user; daoId = id; proposer = user; id = id <> "-founding"
            title = "Founding members"; description = ""
            action = SetShares with changes = more
            rule = Rule OfAll Majority 0 True False
            eligible = sum (map snd shares); createdAt = now; closesAt = now
            yes = 0; no = 0; abstain = 0; tallies = []; outcome = Some Passed; executed = 0
            executedAt = None; secret = None; picked = None
        create DAO with
          provider; operator; creator = user; id; name = daoName; description; image
          equal; routine; sensitive; createdAt = now
          members = length shares; units = sum (map snd shares); actorPays; public

    -- How a party presents itself: a name, a picture, a few words. One per party; replacing
    -- it hands in the old one.
    nonconsuming choice Account_SetProfile : ContractId Profile
      with
        name : Text
        avatar : Optional Text
        bio : Text
        previous : Optional (ContractId Profile)
      controller user
      do
        assertMsg "A profile needs a name" (name /= "")
        forA_ previous \cid -> do
          old <- fetch cid
          assertMsg "Not this party's profile" (old.user == user)
          archive cid
        now <- getTime
        create Profile with provider; operator; user; name; avatar; bio; updatedAt = now

-- | A DAO: who created it, what it is called, and how big its vote is. The
-- members themselves are `Member` contracts, so a DAO of ten thousand is as small as one of
-- three. Nobody changes it by hand: its one choice carries out what a vote decided. The
-- creator's signature is what keeps the provider from archiving it alone.
template DAO
  with
    provider : Party
    operator : Party
    creator : Party
    id : Text
    name : Text
    description : Text
    image : Optional Text
    -- One member, one unit: the vote is by membership rather than by shares.
    equal : Bool
    -- What proposals run under: routine ones (a decision, a name) and sensitive ones (members
    -- and shares, the rules, dissolution).
    routine : Settings
    sensitive : Settings
    createdAt : Time
    members : Int
    -- The whole vote: what every member's units add up to.
    units : Int
    -- Each member pays the traffic of what they sign, from their own balance; otherwise the
    -- DAO's balance pays for everything. Absent means the DAO pays (a DAO from before this
    -- field existed).
    actorPays : Optional Bool
    -- Anyone signed in to the app may read it — its proposals, outcomes, members and
    -- comments — through the app; only members act. Absent means private.
    public : Optional Bool
  where
    signatory creator, provider
    observer operator

    ensure name /= "" && members > 0 && units > 0

    -- A passed proposal is carried out by the provider, with the DAO's authority and the
    -- ledger's check that it did pass. A share change is carried out a batch at a time, from
    -- where the proposal says it got to, up to `upTo`: the contracts of the members it touches
    -- are handed in (the ledger checks each is this DAO's and named in the batch); those with
    -- a new number of units are reshared, those at zero leave, those without a contract join.
    -- A dissolution archives the DAO and returns nothing.
    choice DAO_Execute : Optional (ContractId DAO)
      with
        proposal : ContractId Proposal
        current : [ContractId Member]
        upTo : Int
      controller provider
      do
        p <- fetch proposal
        assertMsg "Not this DAO's proposal" (p.daoId == id && p.creator == creator)
        now <- getTime
        case p.action of
          Signal -> do
            exercise proposal Proposal_Advance with upTo = 1
            Some <$> create this
          Choose _ _ -> do
            exercise proposal Proposal_Advance with upTo = 1
            Some <$> create this
          SetInfo daoName description image -> do
            exercise proposal Proposal_Advance with upTo = 1
            Some <$> create this with name = daoName; description; image
          Dissolve -> do
            exercise proposal Proposal_Advance with upTo = 1
            pure None
          SetSettings routine sensitive -> do
            exercise proposal Proposal_Advance with upTo = 1
            Some <$> create this with routine; sensitive
          SetPublic p -> do
            exercise proposal Proposal_Advance with upTo = 1
            Some <$> create this with public = Some p
          SetShares changes -> do
            let from = p.executed
                slice = take (upTo - from) (drop from changes)
            assertMsg "The batch must move on" (upTo > from && upTo <= length changes)
            assertMsg "A batch is at most a batch" (upTo - from <= batch)
            exercise proposal Proposal_Advance with upTo
            assertMsg "A member handed in twice" (dedup current == current)
            existing <- forA current \cid -> do
              member <- fetch cid
              assertMsg "Not a member of this DAO" (member.daoId == id && member.creator == creator)
              assertMsg "A member not in this batch" (isSome (lookup member.party slice))
              pure (member.party, (cid, member.share))
            (dMembers, dUnits) <- foldlA
              (\(dm, du) (party, units) -> case lookup party existing of
                Some (cid, had)
                  | units == 0 -> do
                      exercise cid Member_Remove
                      pure (dm - 1, du - had)
                  | units == had -> pure (dm, du)
                  | otherwise -> do
                      void (exercise cid Member_Reshare with share = units)
                      pure (dm, du + units - had)
                None
                  | units == 0 -> pure (dm, du)
                  | otherwise -> do
                      void $ create Member with
                        provider; operator; creator; daoId = id; party
                        since = now; share = units; shareSince = now; voted = []
                      pure (dm + 1, du + units))
              (0, 0) slice
            Some <$> create this with members = members + dMembers; units = units + dUnits

-- | One party's membership of one DAO, with its share of the vote: the door through which the
-- member proposes, votes and comments. Voting replaces it with a copy that remembers the
-- proposal, which is what makes a second ballot impossible. Signed by the DAO's own authority,
-- creator and provider, so neither can invent members alone; removed only with the same.
template Member
  with
    provider : Party
    operator : Party
    creator : Party
    daoId : Text
    party : Party
    since : Time
    -- Units of the vote.
    share : Int
    shareSince : Time
    -- Proposals voted on whose deadline has not passed, with that deadline. Nothing can be cast
    -- on a proposal after its deadline, so entries past it are forgotten as the next vote is
    -- cast, and the contract stays the size of the member's open business, not their history.
    voted : [(Text, Time)]
  where
    signatory provider, creator
    observer party, operator

    choice Member_Remove : ()
      controller provider, creator
      do pure ()

    choice Member_Reshare : ContractId Member
      with
        share : Int
      controller provider, creator
      do
        now <- getTime
        create this with share; shareSince = now

    -- The DAO is read as it is now (the app's operator reads alongside the member): the size
    -- of its vote is fixed into the proposal as the electorate, its settings for this kind of
    -- action give the rule and the deadline, and voting is open from this moment. What
    -- members vote on is what was proposed.
    nonconsuming choice Member_Propose : ContractId Proposal
      with
        dao : ContractId DAO
        pid : Text
        title : Text
        description : Text
        action : Effect
        -- A secret ballot: the app shows nobody who voted how (the provider, which counts,
        -- sees the ballots regardless). Absent on proposals made before there was such a thing.
        secret : Optional Bool
        -- A decision or a choice changes nothing on the ledger, so its proposer says what it
        -- takes to pass and for how long it is open; the DAO's settings stand in where these
        -- are absent. Anything that changes the DAO runs under the DAO's sensitive settings,
        -- and these must be absent.
        rule : Optional Rule
        votingDays : Optional Int
      controller party
      do
        now <- getTime
        found <- fetch dao
        assertMsg "Not this member's DAO" (found.id == daoId && found.creator == creator)
        let sensitive = isSensitive action
            settings = if sensitive then found.sensitive else found.routine
        assertMsg "A proposal that changes the DAO runs under the DAO's rule"
          (not sensitive || (isNone rule && isNone votingDays))
        let chosen = Settings with
              rule = fromOptional settings.rule rule
              votingDays = fromOptional settings.votingDays votingDays
        assertMsg "The rule's numbers are out of range" (validSettings chosen)
        let rule = chosen.rule
            closesAt = addRelTime now (days chosen.votingDays)
        case action of
          Signal -> pure ()
          Choose options _ ->
            assertMsg "Two to ten distinct options, eighty characters each at most" (validOptions options)
          Dissolve -> pure ()
          SetSettings routine sensitive ->
            assertMsg "The settings' numbers are out of range" (validSettings routine && validSettings sensitive)
          SetPublic _ -> pure ()
          SetInfo daoName _ _ -> assertMsg "A DAO needs a name" (daoName /= "")
          SetShares changes ->
            assertMsg "The share change must be whole" (validChanges found.equal changes)
        create Proposal with
          provider; operator; creator; daoId; proposer = party; id = pid; title; description
          action; rule; eligible = found.units; createdAt = now; closesAt
          yes = 0; no = 0; abstain = 0; outcome = None; executed = 0; executedAt = None
          tallies = case action of
            Choose options _ -> map (const 0) options
            _ -> []
          secret
          picked = case action of
            Choose _ (Some True) -> Some 0
            _ -> None

    -- Nothing here reads the proposal, so a vote never waits on the count or on other voters.
    -- Whether the ballot is valid for its proposal (right DAO, member in time, before the
    -- deadline) is checked when the provider counts it. `closesAt` and `changeable` are the
    -- voter's word for the proposal's; a voter who lies about them only wastes a ballot the
    -- count will refuse. On a proposal whose votes may change, a second vote hands in the
    -- ballot it replaces.
    choice Member_Vote : ContractId Ballot
      with
        proposalId : Text
        closesAt : Time
        changeable : Bool
        vote : Vote
        previous : Optional (ContractId Ballot)
      controller party
      do
        now <- getTime
        let open = filter (\(_, deadline) -> deadline > now) voted
        if proposalId `elem` map fst open
          then do
            assertMsg "Already voted; votes on this proposal cannot be changed" changeable
            case previous of
              None -> abort "Already voted; hand in the ballot to replace"
              Some cid -> do
                old <- fetch cid
                assertMsg "Not this member's ballot on this proposal"
                  (old.voter == party && old.proposalId == proposalId && old.daoId == daoId)
                -- The ballot on record is the one cast against this deadline; any other of the
                -- voter's, cast against a made-up one, is not a vote and does not buy another.
                assertMsg "Not the ballot on record" (old.closesAt == closesAt && old.changeable)
                exercise cid Ballot_Withdraw
            void (create this with voted = open)
          else void (create this with voted = (proposalId, closesAt) :: open)
        create Ballot with
          provider; operator; creator; daoId; proposalId; voter = party; since; vote; weight = share
          shareSince; closesAt; changeable; castAt = now; counted = False

    -- A word on a proposal, from a member. Anyone in the DAO reads it through the app.
    nonconsuming choice Member_Comment : ContractId Comment
      with
        proposalId : Text
        cid : Text
        body : Text
      controller party
      do
        assertMsg "A comment says something" (body /= "")
        now <- getTime
        create Comment with
          provider; operator; creator; daoId; proposalId; author = party; id = cid; body
          createdAt = now

-- | A proposal counts; it does not list. Its electorate was fixed when it was made: the units
-- of that moment; its rule says what passing takes. With `early` it settles the moment the
-- outcome can no longer change; either way the deadline decides by what was cast. Nobody
-- withdraws it: once made, it is decided. An action is carried out by the DAO once it has
-- passed, in batches when it is long; `executed` is how far that got.
template Proposal
  with
    provider : Party
    operator : Party
    creator : Party
    daoId : Text
    proposer : Party
    id : Text
    title : Text
    description : Text
    action : Effect
    rule : Rule
    eligible : Int
    createdAt : Time
    closesAt : Time
    yes : Int
    no : Int
    abstain : Int
    -- Units per option, for a choice among options; empty otherwise.
    tallies : [Int]
    outcome : Optional Outcome
    executed : Int
    executedAt : Optional Time
    -- Who voted how is not shown by the app. Absent on proposals made before there was such a thing.
    secret : Optional Bool
    -- Units of the ballots that picked options, on a choice that takes several picks: what an
    -- option is measured against where the rule counts the votes cast, since one ballot can
    -- stand behind several options. Absent elsewhere.
    picked : Optional Int
  where
    signatory proposer, provider, creator
    observer operator

    ensure title /= "" && eligible > 0

    -- `final` says the deadline has passed and these are the last ballots there are: the one
    -- thing the ledger takes on the provider's word, since it cannot see what was not handed
    -- in. Votes that may change are counted only once they no longer can.
    choice Proposal_Tally : ContractId Proposal
      with
        ballots : [ContractId Ballot]
        final : Bool
      controller provider
      do
        assertMsg "Already settled" (isNone outcome)
        now <- getTime
        assertMsg "Votes may change until the deadline" (not rule.changeable || now >= closesAt)
        let bump is weight ts = zipWith (\j t -> if j `elem` is then t + weight else t) [0 .. length ts - 1] ts
        (y, n, a, ts, pk) <- foldlA
          (\(y, n, a, ts, pk) cid -> do
            (vote, weight) <- exercise cid Ballot_Count with proposal = this
            pure case vote of
              Yes -> (y + weight, n, a, ts, pk)
              No -> (y, n + weight, a, ts, pk)
              Abstain -> (y, n, a + weight, ts, pk)
              Pick i -> (y, n, a, bump [i] weight ts, pk + weight)
              PickMany is -> (y, n, a, bump is weight ts, pk + weight))
          -- Where one ballot picks one option, the units that picked are the tallies' sum.
          (yes, no, abstain, tallies, fromOptional (sum tallies) picked) ballots
        let isChoice = case action of
              Choose _ _ -> True
              _ -> False
            several = case action of
              Choose _ (Some True) -> True
              _ -> False
            -- On a choice, the leading option stands where yes stands and the rest where no does.
            lead = if isChoice then foldl max 0 ts else y
            second = case (isChoice, sortBy (\p q -> compare q p) ts) of
              (True, _ :: s :: _) -> s
              _ -> 0
            rest = if isChoice then sum ts - lead else n
            cast = y + n + a + pk
            outstanding = eligible - cast
            quorumMet = rule.quorum == 0 || cast * 100 >= rule.quorum * eligible
            meets yes denom = denom > 0 && case rule.threshold of
              Majority -> yes * 2 > denom
              Percent p -> yes * 100 >= denom * p
              Fraction num den -> yes * den >= denom * num
            -- What the leader is measured against now, and in the worst case still to come.
            denomNow = case rule.basis of
              OfAll -> eligible
              OfCast -> lead + rest
            denomWorst = case rule.basis of
              OfAll -> eligible
              OfCast -> lead + rest + outstanding
            -- A choice needs one leader: a tie is no decision.
            passedNow = quorumMet && meets lead denomNow && (not isChoice || lead > second)
            -- Sure: the leader wins whatever the rest do. Lost: nothing can reach the rule
            -- even if the rest all agree.
            sure = quorumMet && meets lead denomWorst && (not isChoice || lead - second > outstanding)
            lost = not (meets (lead + outstanding) denomWorst)
            over = final && now >= closesAt
            won = if isChoice then Chosen (fromSome (elemIndex lead ts)) else Passed
            -- Several picks: each option is measured on its own against the units that picked
            -- (or the whole vote); every option that reaches the rule is chosen. Settled early
            -- once every option is sure to reach it or cannot any more.
            manyDenomNow = case rule.basis of
              OfAll -> eligible
              OfCast -> pk
            manyDenomWorst = case rule.basis of
              OfAll -> eligible
              OfCast -> pk + outstanding
            indexed = zip [0 .. length ts - 1] ts
            reached = [i | (i, t) <- indexed, quorumMet && meets t manyDenomNow]
            sureT t = quorumMet && meets t manyDenomWorst
            lostT t = not (meets (t + outstanding) manyDenomWorst)
            manySettled = all (\t -> sureT t || lostT t) ts
            wonMany = if null reached then Failed else ChosenMany reached
            decided
              | several && rule.early && manySettled = Some wonMany
              | several && over = Some wonMany
              | several = None
              | rule.early && sure = Some won
              | rule.early && lost = Some Failed
              | over = Some (if passedNow then won else Failed)
              | otherwise = None
        create this with
          yes = y; no = n; abstain = a; tallies = ts; outcome = decided
          picked = if several then Some pk else picked

    -- Only the DAO (creator and provider together) records progress on a passed proposal:
    -- how many of its entries are carried out, and the moment the last one was.
    choice Proposal_Advance : ContractId Proposal
      with
        upTo : Int
      controller provider, creator
      do
        assertMsg "The proposal did not pass" (case outcome of
          Some Passed -> True
          Some (Chosen _) -> True
          Some (ChosenMany _) -> True
          _ -> False)
        assertMsg "Already executed" (isNone executedAt)
        let size = case action of
              SetShares changes -> length changes
              _ -> 1
        assertMsg "Progress only goes forward" (upTo > executed && upTo <= size)
        now <- getTime
        create this with
          executed = upTo
          executedAt = if upTo == size then Some now else None

-- | One vote, weighing the voter's units. Signed by the voter and the provider; `since` and
-- `shareSince` are copied from the voter's membership, so the count can tell whether they were
-- a member, with that share, when the vote opened. Counting marks it rather than removing it,
-- so who voted how stays on the ledger; a changed vote withdraws it instead.
template Ballot
  with
    provider : Party
    operator : Party
    creator : Party
    daoId : Text
    proposalId : Text
    voter : Party
    since : Time
    vote : Vote
    weight : Int
    shareSince : Time
    closesAt : Time
    changeable : Bool
    castAt : Time
    counted : Bool
  where
    signatory voter, provider, creator
    observer operator

    choice Ballot_Count : (Vote, Int)
      with
        proposal : Proposal
      controller provider
      do
        assertMsg "Already counted" (not counted)
        assertMsg "A ballot for another proposal" (proposalId == proposal.id && daoId == proposal.daoId)
        assertMsg "A ballot under another authority" (creator == proposal.creator)
        assertMsg "Cast after the deadline" (castAt < proposal.closesAt)
        assertMsg "Cast against another deadline" (closesAt == proposal.closesAt)
        assertMsg "Cast against another rule" (changeable == proposal.rule.changeable)
        assertMsg "Joined after the vote opened" (since <= proposal.createdAt)
        assertMsg "The share changed after the vote opened" (shareSince <= proposal.createdAt)
        case (proposal.action, vote) of
          (Choose options _, Pick i) -> assertMsg "No such option" (i >= 0 && i < length options)
          (Choose options several, PickMany is) -> do
            assertMsg "This proposal takes one option" (several == Some True)
            assertMsg "Pick at least one option" (not (null is))
            assertMsg "No such option" (all (\i -> i >= 0 && i < length options) is)
            assertMsg "An option picked twice" (length (dedup is) == length is)
          (Choose _ _, Abstain) -> pure ()
          (Choose _ _, _) -> abort "This proposal is a choice among options, not yes or no"
          (_, Pick _) -> abort "This proposal takes yes or no, not an option"
          (_, PickMany _) -> abort "This proposal takes yes or no, not options"
          _ -> pure ()
        create this with counted = True
        pure (vote, weight)

    -- The voter takes it back to cast another; only where votes may change, and only before
    -- it was counted.
    choice Ballot_Withdraw : ()
      controller voter
      do
        assertMsg "Votes on this proposal cannot be changed" changeable
        assertMsg "Already counted" (not counted)
        pure ()

-- | A member's comment on a proposal: said once, on the record. Nobody edits or removes it.
template Comment
  with
    provider : Party
    operator : Party
    creator : Party
    daoId : Text
    proposalId : Text
    author : Party
    id : Text
    body : Text
    createdAt : Time
  where
    signatory provider, author, creator
    observer operator

    ensure body /= ""

-- | How a party presents itself to the DAOs it is in.
template Profile
  with
    provider : Party
    operator : Party
    user : Party
    name : Text
    avatar : Optional Text
    bio : Text
    updatedAt : Time
  where
    signatory provider, user
    observer operator

    ensure name /= ""

-- | The provider's statement of a DAO's account with it: what was paid in for the DAO (coin
-- sent to the provider with the DAO's memo) and what its transactions have cost so far. The
-- balance is the difference. Rewritten as the numbers move; one contract per DAO, whatever
-- its history.
template Meter
  with
    provider : Party
    operator : Party
    daoId : Text
    credited : Decimal
    charged : Decimal
    updatedAt : Time
  where
    signatory provider
    observer operator

    choice Meter_Update : ContractId Meter
      with
        newCredited : Decimal
        newCharged : Decimal
      controller provider
      do
        now <- getTime
        create this with credited = newCredited; charged = newCharged; updatedAt = now

-- | The provider's statement of a party's own account with it: coin sent to the provider with
-- the memo of the key's fingerprint, less what the party's own transactions cost — the party
-- itself, its profile, the DAOs it founds, and in a DAO where each member pays, what it
-- signs there. Made when the party is allocated, which is paid from it; one per key.
template Purse
  with
    provider : Party
    operator : Party
    fingerprint : Text
    party : Optional Party
    credited : Decimal
    charged : Decimal
    updatedAt : Time
  where
    signatory provider
    observer operator

    choice Purse_Update : ContractId Purse
      with
        newParty : Optional Party
        newCredited : Decimal
        newCharged : Decimal
      controller provider
      do
        now <- getTime
        create this with party = newParty; credited = newCredited; charged = newCharged; updatedAt = now
