# Copy to testnet.env / mainnet.env next to this file; never committed, never copied to a server.

# Public address Caddy binds to; the validator's nginx already holds :80 on loopback.
PUBLIC_IP=203.0.113.10

# Two provider-side parties (Featured App Coupon Guidance, separate party concerns):
# the provider holds the FeaturedAppRight, signs every proxy and receives traffic rewards;
# the operator is the backend's own party, an observer that reads and never earns.
PROVIDER_PARTY=app-provider::1220...
OPERATOR_PARTY=app-operator::1220...

# Ledger user the server submits as, and the token it signs. `unsafe` matches a validator
# running dev-mode auth; with a real IdP these change.
LEDGER_USER_ID=administrator
LEDGER_AUTH_AUDIENCE=https://ledger_api.example.com
LEDGER_AUTH_SECRET=unsafe

# The domain Caddy serves the app on; DNS points it at PUBLIC_IP.
APP_DOMAIN=app.example.com

# Docker network created by the validator's compose project.
VALIDATOR_NETWORK=splice-validator_default
