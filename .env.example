# Copy to testnet.env / mainnet.env next to this file; never committed, never copied to a server.

# Public address Caddy binds to; the validator's nginx already holds :80 on loopback.
PUBLIC_IP=203.0.113.10

# The app's own party, syncvotes-app-provider, allocated and printed by
# scripts/setup-participant.mjs; not the validator's party. It signs every contract alongside the
# users (so it confirms every transaction and earns the traffic rewards), receives the coin paid
# in by memo, counts the votes, and is what the backend reads as.
PROVIDER_PARTY=syncvotes-app-provider::1220...
# Where users pay in by memo: the validator operator's own party, whose wallet buys the traffic
# (its own transfer pre-approval lets coin land in one step). Empty: the provider.
PAYEE_PARTY=validator-operator::1220...
# From when memos count (ISO time), in the payee's and the provider's histories alike; set it
# when the accounts start afresh (a new package, a new provider) and move the balances over.
DEPOSITS_SINCE=2026-01-01T00:00:00Z

# Identity provider (Keycloak, served under /auth on APP_DOMAIN). The validator bundle's .env
# points at the same realm; see README "Authentication".
LEDGER_API_AUDIENCE=https://canton.network.global
VALIDATOR_AUDIENCE=https://app.example.com/validator-api
WALLET_UI_URL=http://wallet.localhost
CNS_UI_URL=http://ans.localhost
# The network's public Scan (Canton Coin rules, rounds, prices; token-standard registry).
SCAN_URL=https://scan.sv-1.test.global.canton.network.sync.global
# A multiple of what traffic costs net of the rewards it earns back (the validator's, and the
# provider's where it earns app rewards), worked out by the app from Scan. One: the net cost;
# below one: the validator's wallet subsidises the rest.
BILLING_FACTOR=1
# The least a payer is charged, as a fraction of the network's traffic price, even where rewards
# come to the whole cost or more (0.1: never below a tenth of the price). 0: no floor.
BILLING_FLOOR=0
# Record a featured app activity marker (CIP-0047) with each DAO, proposal, vote and change
# carried out, where the provider holds a featured app right. Where the network mints app
# rewards by marker, a marked transaction is charged less what its marker brings.
MARKERS=true
# The validator operator's wallet login; must equal the validator's PARTY_HINT.
WALLET_USER_NAME=validator-operator
KC_ADMIN_PASSWORD=change-me
KC_DB_PASSWORD=change-me
# OAuth client secrets: the validator backend's and this app's.
KC_VALIDATOR_SECRET=change-me
KC_APP_SECRET=change-me
# Fixed ids for the realm's users, so the ledger user names are known before the first import.
KC_VALIDATOR_USER_ID=00000000-0000-4000-8000-000000000001
KC_APP_USER_ID=00000000-0000-4000-8000-000000000002
KC_WALLET_USER_ID=00000000-0000-4000-8000-000000000003
KC_WALLET_USER_PASSWORD=change-me

# Shown to users as "Canton TestNet" / "Canton MainNet".
NETWORK=TestNet
# The deployments the header's network pill switches between; this one included.
NETWORKS=MainNet=https://syncvotes.com,TestNet=https://test.syncvotes.com,DevNet=https://dev.syncvotes.com

# The domain Caddy serves the app on; DNS points it at PUBLIC_IP.
APP_DOMAIN=app.example.com

# Docker network created by the validator's compose project.
VALIDATOR_NETWORK=splice-validator_default

# Sign-up by invitation: comma-separated codes; empty opens the door.
INVITE_CODES=

# Where another proxy already holds :80/:443 (traefik, nginx), Caddy goes on loopback and serves
# plain HTTP for that proxy to forward to. Leave these out where Caddy has the ports itself.
# CADDY_HTTP_BIND=127.0.0.1:8085
# CADDY_HTTPS_BIND=127.0.0.1:8445
# CADDY_SITE=http://app.example.com
# CADDY_TRUSTED_EXTRA=172.16.0.0/12
# Traefik routes the domain to Caddy by labels, over its own docker network.
# TRAEFIK=true
# PROXY_NETWORK=traefik
# PROXY_NETWORK_EXTERNAL=true
