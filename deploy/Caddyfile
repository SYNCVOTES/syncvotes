# One public domain. The ledger API and the validator's admin UIs stay off the internet — the
# bundle already binds them to loopback, so nothing here exposes them.
{$APP_DOMAIN} {
	reverse_proxy app:3000
}

# Internal only, never published: the app's server code reaches the participant through this
# name. The validator's nginx routes by Host, and LEDGER_API_URL can only carry a URL, so the
# header is rewritten here instead.
http://json-ledger-api.localhost {
	reverse_proxy nginx:80 {
		header_up Host json-ledger-api.localhost
	}
}
