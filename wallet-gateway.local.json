{
	"hashingScheme": {
		"version": "HASHING_SCHEME_VERSION_V2"
	},
	"kernel": {
		"id": "remote-da",
		"clientType": "remote"
	},
	"server": {
		"admin": "participant_admin"
	},
	"store": {
		"connection": {
			"type": "sqlite",
			"database": ".wallet/store.sqlite"
		}
	},
	"signingStore": {
		"connection": {
			"type": "sqlite",
			"database": ".wallet/signing-store.sqlite"
		}
	},
	"bootstrap": {
		"idps": [
			{
				"id": "idp-self-signed",
				"type": "self_signed",
				"issuer": "self-signed"
			}
		],
		"networks": [
			{
				"id": "canton:localnet",
				"name": "Local Network",
				"description": "Local development network",
				"identityProviderId": "idp-self-signed",
				"auth": {
					"method": "self_signed",
					"issuer": "self-signed",
					"audience": "https://canton.network.global",
					"scope": "openid daml_ledger_api offline_access",
					"clientId": "participant_admin",
					"clientSecret": "unsafe"
				},
				"adminAuth": {
					"method": "self_signed",
					"issuer": "self-signed",
					"audience": "https://canton.network.global",
					"scope": "daml_ledger_api",
					"clientId": "participant_admin",
					"clientSecret": "unsafe"
				},
				"ledgerApi": {
					"baseUrl": "http://localhost:6864"
				}
			}
		]
	}
}
